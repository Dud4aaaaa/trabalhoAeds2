TAMANHO_REGISTRO_FIXO = 176
def aluno_para_bytes_fixo(aluno):

    matricula = str(aluno["matricula"]).ljust(9)
    nome = aluno["nome"].ljust(50)
    cpf = aluno["cpf"].ljust(11)
    curso = aluno["curso"].ljust(30)
    mae = aluno["filiacao_mae"].ljust(30)
    pai = aluno["filiacao_pai"].ljust(30)
    ano = str(aluno["ano_ingresso"]).ljust(4)
    ca = f"{aluno['ca']:.2f}".ljust(5)

    dados = (
        matricula + "|" +
        nome + "|" +
        cpf + "|" +
        curso + "|" +
        mae + "|" +
        pai + "|" +
        ano + "|" +
        ca
    )

    return dados.encode("utf-8")
def armazenamento_fixo(alunos, tamanho_bloco):

    blocos = []
    bloco_atual = bytearray()

    for aluno in alunos:

        registro = aluno_para_bytes_fixo(aluno)

        if len(registro) > tamanho_bloco:

            print(
                "ERRO: O registro",
                aluno["matricula"],
                "é maior que o bloco."
            )

            return []

        # Se o registro não couber no bloco atual,
        # começamos um novo bloco.
        if len(bloco_atual) + len(registro) > tamanho_bloco:

            blocos.append(bloco_atual)

            bloco_atual = bytearray()

        bloco_atual.extend(registro)

    # Adiciona o último bloco
    if len(bloco_atual) > 0:

        blocos.append(bloco_atual)

    return blocos
def armazenamento_variavel_contiguo(alunos, tamanho_bloco):

    blocos = []
    bloco_atual = bytearray()

    for aluno in alunos:

        registro = aluno_para_bytes(aluno)

        if len(registro) > tamanho_bloco:

            print(
                "ERRO: O registro",
                aluno["matricula"],
                "é maior que o bloco."
            )

            return []
    if len(bloco_atual) + len(registro) > tamanho_bloco:

            if len(bloco_atual) > 0:

                blocos.append(bloco_atual)

            bloco_atual = bytearray()

    bloco_atual.extend(registro)

    if len(bloco_atual) > 0:

        blocos.append(bloco_atual)

    return blocos
def armazenamento_variavel_espalhado(alunos, tamanho_bloco):

    blocos = []
    bloco_atual = bytearray()

    for aluno in alunos:

        registro = aluno_para_bytes(aluno)

        posicao = 0

        while posicao < len(registro):

            espaco_disponivel = tamanho_bloco - len(bloco_atual)

            if espaco_disponivel == 0:

                blocos.append(bloco_atual)

                bloco_atual = bytearray()

                espaco_disponivel = tamanho_bloco

            quantidade = min(
                espaco_disponivel,
                len(registro) - posicao
            )

            parte = registro[posicao:posicao + quantidade]

            bloco_atual.extend(parte)

            posicao += quantidade

    if len(bloco_atual) > 0:

        blocos.append(bloco_atual)

    return blocos
def salvar_blocos(blocos, nome_arquivo):

    with open(nome_arquivo, "wb") as arquivo:

        for bloco in blocos:

            arquivo.write(bloco)
def mostrar_estatisticas(blocos, tamanho_bloco):

    if len(blocos) == 0:

        print("Nenhum bloco foi utilizado.")

        return

    total_bytes = 0
    blocos_parciais = 0

    print("\nMAPA DE OCUPAÇÃO DOS BLOCOS:")

    for i, bloco in enumerate(blocos):

        ocupado = len(bloco)

        percentual = (ocupado / tamanho_bloco) * 100

        total_bytes += ocupado

        if ocupado < tamanho_bloco:

            blocos_parciais += 1

        print(
            f"Bloco {i + 1}: "
            f"{ocupado} bytes "
            f"({percentual:.2f}% cheio)"
        )

    quantidade_blocos = len(blocos)

    ocupacao_media = (
        total_bytes /
        (quantidade_blocos * tamanho_bloco)
    ) * 100

    print("\nESTATÍSTICAS:")

    print(
        "Número total de blocos:",
        quantidade_blocos
    )

    print(
        f"Ocupação média dos blocos: "
        f"{ocupacao_media:.2f}%"
    )

    print(
        "Número de blocos parcialmente utilizados:",
        blocos_parciais
    )

    print(
        f"Eficiência de armazenamento: "
        f"{ocupacao_media:.2f}%"
    )
