    aluno = {
        "matricula": matricula,
        "nome": nome_aluno,
        "cpf": fake.cpf(),
        "curso": random.choice(cursos),
        "filiacao_mae": nome_mae,
        "filiacao_pai": nome_pai,
        "ano_ingresso":  random.randint(2015, 2026),
        "ca": round(random.uniform(0, 10), 2)
        
    }
    return aluno

quantidade = int(input("Digite a quantidade de registros que você quer: "))
def merge_sort(alunos):

    if len(alunos) <= 1:
        return alunos

    meio = len(alunos) // 2

    esquerda = merge_sort(alunos[:meio])
    direita = merge_sort(alunos[meio:])

    resultado = []

    i = 0
    j = 0

    while i < len(esquerda) and j < len(direita):

        if esquerda[i]["matricula"] < direita[j]["matricula"]:

            resultado.append(esquerda[i])
            i += 1

        else:

            resultado.append(direita[j])
            j += 1

    while i < len(esquerda):

        resultado.append(esquerda[i])
        i += 1

    while j < len(direita):

        resultado.append(direita[j])
        j += 1

    return resultado
